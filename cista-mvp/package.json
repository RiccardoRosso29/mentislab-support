{
  "name": "cista-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CiSta: arreda casa solo con mobili che ci stanno davvero (MVP)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",

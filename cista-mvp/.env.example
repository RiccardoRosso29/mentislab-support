# Copia in .env e compila: i valori non vanno mai nel repository.
# Senza questi valori il sito usa solo il catalogo seed e link non affiliati.

# --- Link di affiliazione lato sito (pubblici per definizione: finiscono nei link) ---
VITE_AMAZON_TAG=
VITE_AWIN_AFFID=
# Id inserzionista Awin per negozio (awinmid), quando approvati
VITE_AWIN_MID_LEROYMERLIN_ES=
VITE_AWIN_MID_LEROYMERLIN_IT=
# Endpoint opzionale per inviare gli eventi anonimi (es. Plausible/PostHog self-hosted)
VITE_ANALYTICS_URL=

# --- Importazione catalogo (solo script, mai nel bundle) ---
AWIN_FEED_API_KEY=
AWIN_ADVERTISER_IDS=
AWIN_LOCALE=es_ES
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_MARKETPLACE=www.amazon.es
# Estrazione misure con LLM: disattivata salvo --enable
ANTHROPIC_API_KEY=
LLM_DIMS_BUDGET_USD=2
